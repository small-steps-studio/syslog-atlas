{
  "name": "syslog-atlas",
  "displayName": "Syslog Atlas",
  "description": "Syslog and CEF log files: summary, parse check, severity overview. Pro: sources and security events such as failed logins. Works offline.",
  "version": "0.1.0",
  "publisher": "SmallStepsStudio",
  "license": "SEE LICENSE IN LICENSE.txt",
  "icon": "media/icon.png",
  "pricing": "Trial",
  "homepage": "https://github.com/small-steps-studio/syslog-atlas#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/small-steps-studio/syslog-atlas"
  },
  "bugs": {
    "url": "https://github.com/small-steps-studio/syslog-atlas/issues"
  },
  "galleryBanner": {
    "color": "#2a2f1f",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "syslog",
    "log analysis",
    "log viewer",
    "rfc 5424",
    "rfc 3164",
    "cef",
    "auth.log",
    "ssh",
    "failed login",
    "brute force",
    "sudo",
    "security log",
    "siem",
    "soc",
    "incident response",
    "linux logs",
    "sysadmin",
    "severity",
    "log parser",
    "offline"
  ],
  "main": "./src/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [],
  "scripts": {
    "test": "node scripts/run-tests.js",
    "gate": "node scripts/release-gate.js",
    "vscode:prepublish": "node scripts/release-gate.js --skip-tests",
    "package": "npx --yes @vscode/vsce package --no-dependencies",
    "package:local": "node scripts/package-local.js",
    "check-vsix": "node scripts/check-vsix.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "syslogAtlas.showSummary",
        "title": "Syslog Atlas: Show Log Summary",
        "icon": "$(output)"
      },
      {
        "command": "syslogAtlas.showParse",
        "title": "Syslog Atlas: Show Parse Check"
      },
      {
        "command": "syslogAtlas.showSeverity",
        "title": "Syslog Atlas: Show Severity Overview"
      },
      {
        "command": "syslogAtlas.showSources",
        "title": "Syslog Atlas: Show Sources (Pro)"
      },
      {
        "command": "syslogAtlas.showSecurity",
        "title": "Syslog Atlas: Show Security Events (Pro)"
      },
      {
        "command": "syslogAtlas.openSample",
        "title": "Syslog Atlas: Open Sample File"
      },
      {
        "command": "syslogAtlas.openWalkthrough",
        "title": "Syslog Atlas: Open Walkthrough"
      },
      {
        "command": "syslogAtlas.showDocumentation",
        "title": "Syslog Atlas: Show Documentation"
      },
      {
        "command": "syslogAtlas.reportProblem",
        "title": "Syslog Atlas: Report A Problem"
      },
      {
        "command": "syslogAtlas.buyPro",
        "title": "Syslog Atlas: Buy Pro"
      },
      {
        "command": "syslogAtlas.enterKey",
        "title": "Syslog Atlas: Enter Licence Key"
      },
      {
        "command": "syslogAtlas.licenceStatus",
        "title": "Syslog Atlas: Show Licence Status"
      },
      {
        "command": "syslogAtlas.removeLicence",
        "title": "Syslog Atlas: Remove Licence From This Machine"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "syslogAtlas.showSummary",
          "when": "resourceExtname == .log || resourceFilename =~ /^(syslog|messages|auth\\.log|secure)(\\.\\d+)?$/",
          "group": "navigation@90"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get started with Syslog Atlas",
        "description": "Open a sample log, see its summary, parse check and severity overview, and try the Pro sources and security events reports in the free 14-day trial.",
        "steps": [
          {
            "id": "syslogAtlas.step.openSample",
            "title": "Open a sample file",
            "description": "Syslog Atlas reads syslog lines in the RFC 5424 and BSD formats and CEF events, mixed in one file. The sample is an invented server log with a burst of failed logins, a firewall event and a garbled line, so every report has something to show.\n[Open Sample File](command:syslogAtlas.openSample)",
            "media": {
              "markdown": "media/walkthrough/open-sample.md"
            },
            "completionEvents": [
              "onCommand:syslogAtlas.openSample"
            ]
          },
          {
            "id": "syslogAtlas.step.free",
            "title": "Run Show Log Summary",
            "description": "The log at a glance: lines per format, hosts, first and last entry, and the busiest programs. The report opens as a new Markdown document; your file is not changed.\n[Show Log Summary](command:syslogAtlas.showSummary)",
            "media": {
              "markdown": "media/walkthrough/free.md"
            },
            "completionEvents": [
              "onCommand:syslogAtlas.showSummary"
            ]
          },
          {
            "id": "syslogAtlas.step.more",
            "title": "Use the other free reports",
            "description": "Every free report works without a key, an account or a network connection: Show Parse Check, Show Severity Overview.\n[Show Parse Check](command:syslogAtlas.showParse)\n[Show Severity Overview](command:syslogAtlas.showSeverity)",
            "media": {
              "markdown": "media/walkthrough/more.md"
            },
            "completionEvents": [
              "onCommand:syslogAtlas.showParse",
              "onCommand:syslogAtlas.showSeverity"
            ]
          },
          {
            "id": "syslogAtlas.step.pro",
            "title": "Try Pro free for 14 days",
            "description": "The first Pro command you run starts a free 14-day trial on this computer, with no key and no network: Show Sources, Show Security Events.\n[Show Sources](command:syslogAtlas.showSources)",
            "media": {
              "markdown": "media/walkthrough/pro.md"
            },
            "completionEvents": [
              "onCommand:syslogAtlas.showSources",
              "onCommand:syslogAtlas.showSecurity"
            ]
          },
          {
            "id": "syslogAtlas.step.licence",
            "title": "Licence and help",
            "description": "Buy Pro (Personal USD 19, Business USD 39 per user), enter a key, see the licence status, or report a problem.\n[Show Licence Status](command:syslogAtlas.licenceStatus)\n[Report A Problem](command:syslogAtlas.reportProblem)",
            "media": {
              "markdown": "media/walkthrough/licence.md"
            },
            "completionEvents": [
              "onCommand:syslogAtlas.licenceStatus"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "Syslog Atlas",
      "properties": {
        "syslogAtlas.maxFileSizeMB": {
          "type": "number",
          "default": 50,
          "minimum": 0.1,
          "maximum": 50,
          "markdownDescription": "Largest file (in MB) a report reads, up to 50 MB (VS Code passes files only up to 50 MB to extensions). Larger files are refused with a message."
        },
        "syslogAtlas.openReportsAsPreview": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Open each report in the Markdown preview as well as in a new editor."
        }
      }
    }
  }
}
